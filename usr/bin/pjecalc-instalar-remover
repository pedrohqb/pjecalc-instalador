#!/bin/bash

TITULO="Instalador não oficial do PjeCalc"

# Janelas de diálogo (zenity)
aviso() {   # aviso TEXTO [TÍTULO]
    zenity --info --no-markup --width=420 --title="${2:-$TITULO}" --text="$1"
}
erro() {    # erro TEXTO
    zenity --error --no-markup --width=420 --title="$TITULO" --text="$1"
}
confirma() {    # confirma TEXTO BOTÃO-SIM BOTÃO-NÃO; retorna 0 só se o usuário clicar em BOTÃO-SIM
    zenity --question --no-markup --width=420 --title="$TITULO" --text="$1" \
        --ok-label="$2" --cancel-label="$3" --default-cancel
}


if [ -e "$HOME/PjeCalc/bin/pjecalc.jar" ]; then

    ESCOLHA=$(zenity --question --no-markup --width=420 --title="$TITULO" \
        --text="O PjeCalc já está instalado.

Deseja reinstalar ou atualizar o PjeCalc, ou removê-lo?" \
        --ok-label="Reinstalar ou atualizar o PjeCalc" --cancel-label="Sair" \
        --extra-button="REMOVER o PjeCalc")
    RESPOSTA=$?

    if [ "$ESCOLHA" = "REMOVER o PjeCalc" ]; then

        if confirma "Confirma que deseja REMOVER o PjeCalc e todos os cálculos salvos nele?" \
            "Confirmo, REMOVA o PjeCalc!" "Manter o PjeCalc instalado"; then
            rm -R "$HOME/PjeCalc"
            aviso "PjeCalc removido!"
        fi
        exit 0
    fi

    if [ "$RESPOSTA" != 0 ]; then
        exit 0
    fi

fi


zenity --question --no-markup --width=420 --title="$TITULO" --ok-label="Continuar" --cancel-label="Cancelar" \
    --text="Este é um instalador não oficial para o programa PjeCalc.

Oficialmente, o PjeCalc só tem instalador para Windows, mas ele é um programa feito em Java e funciona no Linux.

Para prosseguir, faça o download do PjeCalc para Windows e clique em 'Continuar'.

Na tela seguinte, selecione o arquivo .exe do PjeCalc. Serve tanto a versão de 32 quanto a de 64 bits."

if [ "$?" != 0 ]; then
    exit 0
fi

ARQUIVO_EXE=$(zenity --file-selection --title="$TITULO" --filename="$HOME/" \
    --file-filter="Instalador do PjeCalc (.exe) | *.exe *.EXE")

if [ -z "$ARQUIVO_EXE" ]; then
    exit 0
fi

# Fecha o PjeCalc se ele estiver aberto
PIDS_PJECALC=$(ps -aux | grep java | grep pjecalc.jar | awk '{print $2}')
if [ -n "$PIDS_PJECALC" ]; then
    kill $PIDS_PJECALC
fi

rm -Rf "$HOME/.pjecalc-instalando/"

mkdir -p ~/.pjecalc-instalando

cp -f "$ARQUIVO_EXE" "$HOME/.pjecalc-instalando/pjecalc.exe"

if ! [ -e "$HOME/.pjecalc-instalando/pjecalc.exe" ]; then
    exit 0
fi


cd "$HOME/.pjecalc-instalando/" || exit 1

# O pacote p7zip-full fornece o comando 7z; em algumas versões, o pacote 7zip fornece só o 7zz
SETE_ZIP=$(command -v 7z || command -v 7zz)
if [ -z "$SETE_ZIP" ]; then
    erro "Não foi encontrado o 7-Zip (comandos 7z ou 7zz).

Instale o pacote p7zip-full ou 7zip."
    rm -Rf "$HOME/.pjecalc-instalando/"
    exit 1
fi

"$SETE_ZIP" x pjecalc.exe

rm pjecalc.exe

rm -Rf pjecalc-*/navegador
rm -Rf pjecalc-*/bin/jre

mkdir -p ~/PjeCalc

cp -Rf pjecalc-*/* "$HOME/PjeCalc"

if [ -e "$HOME/PjeCalc/.dados" ]; then

    zenity --question --no-markup --width=420 --title="$TITULO" \
        --text="Já existe uma base de dados do PjeCalc neste computador.

Deseja manter os dados atuais ou fazer uma instalação limpa?" \
        --ok-label="MANTER MEUS DADOS" --cancel-label="APAGAR MEUS DADOS"

    if [ "$?" != 0 ]; then

        if confirma "Confirma que deseja apagar os dados preenchidos no PjeCalc?" \
            "Confirmo, apague os dados!" "Não apague os dados"; then
            rm -R "$HOME/PjeCalc/.dados"
            cp -Rf pjecalc-*/.dados "$HOME/PjeCalc/.dados"
        fi
    fi

else

    cp -Rf pjecalc-*/.dados "$HOME/PjeCalc/.dados"

fi

rm -Rf "$HOME/.pjecalc-instalando/"

if [ -e "$HOME/PjeCalc/bin/pjecalc.jar" ]; then

    aviso "O PjeCalc foi instalado na pasta $HOME/PjeCalc. Se você apagar ou renomear essa pasta, o PjeCalc não irá funcionar.

Para utilizar o PjeCalc, abra-o no menu do sistema, na categoria 'Escritório'.

As mensagens de erro de FONTCONFIG podem ser ignoradas." "Instalação concluída"

else
    erro "A instalação não foi concluída.

Confira se o arquivo selecionado é o instalador do PjeCalc para Windows."
fi
